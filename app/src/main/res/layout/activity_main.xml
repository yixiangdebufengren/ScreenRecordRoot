<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/app_name"
        app:titleTextColor="?attr/colorOnSurface"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 录制按钮容器：真正居中 -->
    <FrameLayout
        android:id="@+id/record_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/tv_hint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.45"
        android:padding="8dp">

        <!-- 自定义波浪线圆环（半径正弦起伏的圆环在旋转，真正波浪形） -->
        <com.fengyi.screenrecord.WaveProgressView
            android:id="@+id/progress"
            android:layout_width="188dp"
            android:layout_height="188dp"
            android:layout_gravity="center"
            android:visibility="invisible" />

        <!-- 居中大录制按钮：纯圆形，图标真正居中 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_record"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center"
            app:icon="@drawable/ic_record"
            app:iconSize="44dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            app:cornerRadius="56dp"
            app:backgroundTint="?attr/colorPrimary"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </FrameLayout>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="点击开始录制"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/record_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 底部视频卡片区标题 -->
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:text="已录制的视频"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintBottom_toTopOf="@id/recycler" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>