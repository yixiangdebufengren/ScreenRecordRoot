<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:strokeWidth="0dp"
    app:rippleColor="?attr/colorPrimary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/iv_thumb"
            android:layout_width="108dp"
            android:layout_height="68dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/app_name"
            android:background="?attr/colorSurfaceContainerHighest"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintStart_toEndOf="@id/iv_thumb"
            app:layout_constraintEnd_toStartOf="@id/btn_export"
            app:layout_constraintTop_toTopOf="@id/iv_thumb"
            app:layout_constraintBottom_toTopOf="@id/tv_info" />

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toEndOf="@id/iv_thumb"
            app:layout_constraintEnd_toStartOf="@id/btn_export"
            app:layout_constraintBottom_toBottomOf="@id/iv_thumb" />

        <!-- 导出按钮：保存到相册 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:icon="@drawable/ic_export"
            app:iconSize="20dp"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorPrimary"
            app:cornerRadius="22dp"
            app:backgroundTint="?attr/colorPrimaryContainer"
            app:strokeWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:layout_constraintEnd_toStartOf="@id/btn_delete"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 删除按钮：图标型，垂直居中，无错位 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:icon="@drawable/ic_delete"
            app:iconSize="20dp"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorError"
            app:cornerRadius="22dp"
            app:backgroundTint="?attr/colorErrorContainer"
            app:strokeWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>